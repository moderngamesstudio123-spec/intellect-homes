DirectoryIndex index.php
RewriteEngine On

# Protect enquiry log file from direct public access
<Files "enquiries.log">
    Require all denied
</Files>

# Force HTTPS on Hostinger
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect explicit .php URLs to clean extensionless URLs (except send-mail.php)
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([a-zA-Z0-9_-]+)\.php[\s?] [NC]
RewriteCond %1 !^send-mail$ [NC]
RewriteRule ^ /%1 [R=301,L]

# 301 Redirects from old .html filenames to clean URLs
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^about\.html$ /about-us [R=301,L]
RewriteRule ^designs\.html$ /home-designs [R=301,L]
RewriteRule ^contact\.html$ /contact-us [R=301,L]
RewriteRule ^(facades|floor-plan|gallery|blogs|calculator|inclusions|knockdown-rebuild)\.html$ /$1 [R=301,L]

# Old WordPress single post/design URLs
RewriteRule ^home-design/.*$ /home-designs [R=301,L]
RewriteRule ^blog/?$ /blogs [R=301,L]

# Serve clean URLs (/about-us or /about-us/) from their .php files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L]
