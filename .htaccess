DirectoryIndex index.php
RewriteEngine On

# Force HTTPS on Hostinger
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 301 Redirects from old .html filenames to new .php filenames
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^about\.html$ /about-us.php [R=301,L]
RewriteRule ^designs\.html$ /home-designs.php [R=301,L]
RewriteRule ^contact\.html$ /contact-us.php [R=301,L]
RewriteRule ^(facades|floor-plan|gallery|blogs|calculator|inclusions|knockdown-rebuild)\.html$ /$1.php [R=301,L]

# Old WordPress single post/design URLs
RewriteRule ^home-design/.*$ /home-designs.php [R=301,L]
RewriteRule ^blog/?$ /blogs.php [R=301,L]

# Support trailing-slash and extensionless URLs (e.g. /about-us/ -> about-us.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L]
